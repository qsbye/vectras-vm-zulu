<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1419"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="软件设置"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="设置在下次进入 Alpine 系统时生效"
            android:textColor="#7FA8C9"
            android:textSize="12sp" />

        <!-- 启动屏幕方向 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="启动屏幕方向"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_orientation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rb_landscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="横屏（默认）"
                android:textColor="#C7D0D9" />

            <RadioButton
                android:id="@+id/rb_portrait"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="竖屏"
                android:textColor="#C7D0D9" />
        </RadioGroup>

        <!-- 桌面分辨率 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="桌面分辨率"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_resolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <RadioButton
                android:id="@+id/rb_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="自动适配屏幕物理分辨率（默认）"
                android:textColor="#C7D0D9" />

            <RadioButton
                android:id="@+id/rb_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="手动指定"
                android:textColor="#C7D0D9" />

            <EditText
                android:id="@+id/et_resolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="4dp"
                android:enabled="false"
                android:hint="例如 1280x720（宽x高）"
                android:inputType="text"
                android:textColor="#E4EBF1"
                android:textColorHint="#5E7183" />
        </RadioGroup>

        <TextView
            android:id="@+id/config_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="配置文件：Documents/VectrasVM/config/config.toml"
            android:textColor="#6E7F8F"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
